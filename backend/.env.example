# ============================================================
# UniLink Backend - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unilink_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT Secrets (use strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK (for Google Auth verification + Phone OTP)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# File Upload (local for dev, configure cloud storage for prod)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Setup (initial super-admin bootstrap)
SUPER_ADMIN_EMAIL=admin@unilink.edu
SUPER_ADMIN_PASSWORD=change_this_immediately

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
